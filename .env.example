APP_ENV=development
APP_NAME=EvalWorks
DATABASE_URL=sqlite:///./.data/evalworks.db
# Set a long random value before exposing the service. All write endpoints require it.
API_KEY=local-dev-key-change-me
# Optional OpenAI-compatible endpoint. No external LLM is needed for local demos/tests.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
MAX_REQUEST_BYTES=65536
ALLOWED_ORIGINS=http://localhost:8000
