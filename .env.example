APP_ENV=development
APP_NAME=EvalWorks
DATABASE_URL=sqlite:///./.data/evalworks.db
# Set a long random value before exposing the service. All write endpoints require it.
API_KEY=local-dev-key-change-me
# Required in production. Use a separate random value from API_KEY and SESSION_SECRET.
DATA_HMAC_KEY=
SESSION_SECRET=development-secret-change-before-deploying-32-chars-minimum
COOKIE_SECURE=false
# Optional OpenAI-compatible endpoint. No external LLM is needed for local demos/tests.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_ALLOWED_HOSTS=
MAX_REQUEST_BYTES=65536
ALLOWED_ORIGINS=http://localhost:8000
