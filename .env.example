APP_ENV=development
APP_NAME=EvalWorks
DATABASE_URL=sqlite:///./.data/evalworks.db
# Development API key only; production uses authenticated user sessions.
API_KEY=local-dev-key-change-me
SESSION_SECRET=development-secret-change-before-deploying-32-chars-minimum
# Keep stable while evaluation jobs are queued; use a different random key from API_KEY and SESSION_SECRET.
DATA_ENCRYPTION_KEY=development-data-encryption-key-change-before-deploying
COOKIE_SECURE=false
# Optional in local development. Docker Compose enables Redis for shared rate limits.
REDIS_URL=
# Optional OpenAI-compatible endpoint. No external LLM is needed for local demos/tests.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
MAX_REQUEST_BYTES=65536
ALLOWED_ORIGINS=http://localhost:8000
